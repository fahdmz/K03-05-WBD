{
  "uid": "k03-05-wbd",
  "title": "K03-05-WBD Observability",
  "description": "Antrean, worker, migration, dan pool database server serta worker.",
  "tags": ["k03-05-wbd"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Jumlah job per status",
      "description": "worker_jobs, dihitung dari tabel jobs setiap scrape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (status) (worker_jobs{job=\"worker\"})", "legendFormat": "{{status}}", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job selesai per status (total sejak worker start)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (status) (worker_jobs_finished_total{job=\"worker\"})", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retry per action dan mode (per detik)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (action, mode) (rate(worker_job_retries_total{job=\"worker\"}[$__rate_interval]))", "legendFormat": "{{action}} {{mode}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Waktu tunggu queue (p50, p95, sejak worker start)",
      "description": "Dari worker_queue_wait_seconds, diamati pada claim pertama job. Kumulatif sejak worker start supaya observasi pertama tetap terlihat.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le) (worker_queue_wait_seconds_bucket{job=\"worker\"}))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (worker_queue_wait_seconds_bucket{job=\"worker\"}))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Durasi migration per action dan mode (p50, p95, rata-rata, sejak worker start)",
      "description": "Dari worker_migration_duration_seconds, dari claim sampai selesai. p50 dan p95 diinterpolasi dari bucket, rata-rata dihitung tepat dari _sum dan _count.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le, action, mode) (worker_migration_duration_seconds_bucket{job=\"worker\"}))", "legendFormat": "p50 {{action}} {{mode}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, action, mode) (worker_migration_duration_seconds_bucket{job=\"worker\"}))", "legendFormat": "p95 {{action}} {{mode}}" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (action, mode) (worker_migration_duration_seconds_sum{job=\"worker\"}) / sum by (action, mode) (worker_migration_duration_seconds_count{job=\"worker\"})", "legendFormat": "rata-rata {{action}} {{mode}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Waktu tunggu lock per hasil (p50, p95, sejak worker start)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le, result) (worker_lock_wait_seconds_bucket{job=\"worker\"}))", "legendFormat": "p50 {{result}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, result) (worker_lock_wait_seconds_bucket{job=\"worker\"}))", "legendFormat": "p95 {{result}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Batch committed per arah (per detik)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (direction) (rate(worker_batches_committed_total{job=\"worker\"}[$__rate_interval]))", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Row committed per arah (per detik)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (direction) (rate(worker_rows_committed_total{job=\"worker\"}[$__rate_interval]))", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pool database server (aktif, idle)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (state) (server_db_pool_connections{job=\"server\", state=~\"active|idle\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pool database worker (aktif, idle)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (state) (worker_db_pool_connections{job=\"worker\", state=~\"active|idle\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Waktu tunggu acquire pool (detik per detik)",
      "description": "Kenaikan total waktu tunggu koneksi pool per detik. Nilai mendekati 0 berarti pool tidak antre.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(server_db_pool_acquire_wait_seconds_total{job=\"server\"}[$__rate_interval])", "legendFormat": "server" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(worker_db_pool_acquire_wait_seconds_total{job=\"worker\"}[$__rate_interval])", "legendFormat": "worker" }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Log server dan worker",
      "description": "Dari Loki. Buka detail baris log lalu klik link trace_id untuk membuka trace-nya di Tempo.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none", "prettifyLogMessage": false },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=~\"server|worker\"}", "queryType": "range" }
      ]
    }
  ]
}
